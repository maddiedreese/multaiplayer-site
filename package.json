{
  "name": "multaiplayer-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run aasa:generate && next build && node scripts/generate-static-headers.mjs && node --test tests/static-output.check.mjs",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "aasa:generate": "node scripts/generate-aasa.mjs",
    "release:manifest": "node scripts/update-release-manifest.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "type": "module"
}
